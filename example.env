# Required project configuration
REPOSITORY_ID=your_unique_project_id
QB_REALM=your_quickbase_realm
QB_DBID=your_production_dbid
QB_USERTOKEN=your_production_user_token

# Optional production token
QB_APP_TOKEN=your_production_app_token

# Set to yes when development uses a separate Quickbase application
DEV_AND_PROD_QUICKBASE_APPLICATIONS=no
QB_DEV_DBID=your_development_dbid
QB_DEV_USERTOKEN=your_development_user_token
QB_DEV_APP_TOKEN=your_development_app_token

# Optional page-name prefixes
CUSTOM_PREFIX_PRODUCTION=P
CUSTOM_PREFIX=D
CUSTOM_PREFIX_FEATURE=F
